== SPORT4 FPGA-driven transmitter

This chapter implements an FPGA soft transmitter that pushes a
deterministic PRBS-31 words into SPORT4 half-B
running as a pure slave on the EV-SOMCRR-EZLITE. The FPGA generates ACLK,
AFS and AD0 from its own 12 MHz oscillator via an `SB_PLL40_CORE`
PLL clocked to ~62.25 MHz (one DIVQ step below the
datasheet `fSPTCLKEXT` 62.5 MHz ceiling).

| Role                | DSP DAI1 | Header | FPGA ball |
| ---                 | ---      | ---    | ---       |
| SPORT4B AD0 (in)    | PB05     | P13.10 | G14       |
| SPORT4B ACLK (in)   | PB07     | P13.14 | J15       |
| SPORT4B AFS (in)    | PB08     | P13.16 | H14       |

=== Top module

PLL config from `icepll -i 12 -o 62.5`: DIVR=0, DIVF=82, DIVQ=4,
FILTER_RANGE=1, FEEDBACK_PATH=SIMPLE -- actual output 62.25 MHz.

A 5-bit counter cycles 0..31 per word. AFS pulses high on the
counter==0 cycle (late-frame-sync: AFS is high concurrent with bit 0
of each word, low for bits 1..31). AD0 emits the current word's MSB on each
cycle. AD0 and AFS update on ACLK's falling edge so the DSP receiver
has a half-cycle of setup before sampling on the rising edge. The
transmitter first emits an 8192-word dummy preamble, then holds AFS low
for a quiet gap, then starts the PRBS payload at index 0. The DSP uses
the quiet gap to discard configuration-time residue without accepting
the first received word as a sequence anchor. The PRBS is standard
PRBS-31 with polynomial `x^31 + x^28 + 1`, seed `31'h7fffffff`.
It generates a serial bitstream with
`new_bit = state[30] ^ state[27]`,
`state = ((state << 1) | new_bit) & 31'h7fffffff`, and packs each
32-bit SPORT word MSB-first: word bit 31 is the first generated bit,
word bit 0 is the thirty-second generated bit.

The clock domain is the PLL output. The 12 MHz `J3` pin feeds the
PLL input; ACLK on `J15` is forwarded directly from the PLL output.

<<sport_tx_prbs.v>>=
module sport_tx_prbs (
      input  clk12,
      output ad0_out,
      output aclk_out,
      output afs_out
   );

   wire pll_clk;
   wire pll_lock;

   SB_PLL40_CORE #(
      .FEEDBACK_PATH("SIMPLE"),
      .DIVR(4'd0),
      .DIVF(7'd82),
      .DIVQ(3'd4),
      .FILTER_RANGE(3'd1)
   ) pll (
      .REFERENCECLK(clk12),
      .PLLOUTCORE(pll_clk),
      .LOCK(pll_lock),
      .RESETB(1'b1),
      .BYPASS(1'b0)
   );

   localparam [30:0] PRBS31_SEED   = 31'h7fffffff;
   localparam [31:0] DUMMY_WORD    = 32'hA5A55A5A;
   localparam [13:0] DUMMY_WORDS   = 14'd8192;
   localparam [21:0] IDLE_CYCLES   = 22'd200000;
   localparam [1:0]  PH_DUMMY      = 2'd0;
   localparam [1:0]  PH_IDLE       = 2'd1;
   localparam [1:0]  PH_PATTERN    = 2'd2;

   reg [4:0]  bitcnt      = 5'd0;
   reg [1:0]  phase       = PH_DUMMY;
   reg [13:0] dummy_count = 14'd0;
   reg [21:0] idle_count  = 22'd0;
   reg [30:0] prbs_state  = PRBS31_SEED;
   reg [31:0] shift_word  = 32'd0;
   reg        afs_r       = 1'b0;
   reg        ad0_r       = 1'b0;

   function [31:0] prbs31_word;
      input [30:0] s_in;
      integer i;
      reg [30:0] s;
      reg [31:0] w;
      reg new_bit;
      begin
         s = s_in;
         w = 32'd0;
         for (i = 0; i < 32; i = i + 1) begin
            new_bit = s[30] ^ s[27];
            s = {s[29:0], new_bit};
            w = {w[30:0], new_bit};
         end
         prbs31_word = w;
      end
   endfunction

   function [30:0] prbs31_advance;
      input [30:0] s_in;
      integer i;
      reg [30:0] s;
      reg new_bit;
      begin
         s = s_in;
         for (i = 0; i < 32; i = i + 1) begin
            new_bit = s[30] ^ s[27];
            s = {s[29:0], new_bit};
         end
         prbs31_advance = s;
      end
   endfunction

   wire [31:0] current_payload = prbs31_word(prbs_state);

   // Drive data + AFS on the FALLING edge of pll_clk so the DSP's
   // rising-edge sample sees a value that's already half a period
   // stable. ACLK is forwarded directly from the PLL output.
   always @(negedge pll_clk) begin
      if (!pll_lock) begin
         bitcnt     <= 5'd0;
         phase      <= PH_DUMMY;
         dummy_count <= 14'd0;
         idle_count <= 22'd0;
         prbs_state <= PRBS31_SEED;
         shift_word <= 32'd0;
         afs_r      <= 1'b0;
         ad0_r      <= 1'b0;
      end else begin
         if (phase == PH_IDLE) begin
            afs_r <= 1'b0;
            ad0_r <= 1'b0;
            if (idle_count == IDLE_CYCLES - 22'd1) begin
               phase      <= PH_PATTERN;
               idle_count <= 22'd0;
               bitcnt     <= 5'd0;
            end else begin
               idle_count <= idle_count + 22'd1;
            end
         end else begin
            afs_r <= (bitcnt == 5'd0);
            if (bitcnt == 5'd0) begin
               if (phase == PH_DUMMY) begin
                  ad0_r      <= DUMMY_WORD[31];
                  shift_word <= {DUMMY_WORD[30:0], 1'b0};
               end else begin
                  ad0_r      <= current_payload[31];
                  shift_word <= {current_payload[30:0], 1'b0};
               end
               bitcnt <= 5'd1;
            end else begin
               ad0_r      <= shift_word[31];
               shift_word <= {shift_word[30:0], 1'b0};
               if (bitcnt == 5'd31) begin
                  bitcnt <= 5'd0;
                  if (phase == PH_DUMMY) begin
                     if (dummy_count == DUMMY_WORDS - 14'd1) begin
                        phase       <= PH_IDLE;
                        dummy_count <= 14'd0;
                     end else begin
                        dummy_count <= dummy_count + 14'd1;
                     end
                  end else begin
                     prbs_state <= prbs31_advance(prbs_state);
                  end
               end else begin
                  bitcnt <= bitcnt + 5'd1;
               end
            end
         end
      end
   end

   assign aclk_out = pll_clk;
   assign ad0_out  = ad0_r;
   assign afs_out  = afs_r;

endmodule
@

=== Pin assignment (HX8K-B-EVN)

<<sport_tx_prbs_hx8k.pcf>>=
set_io clk12    J3
set_io ad0_out  G14
set_io aclk_out J15
set_io afs_out  H14
@

=== Build fragment

<<sport_tx_prbs.mk>>=
SPORT_TX_PRBS_VS := verilog/sport_tx_prbs.v
SPORT_TX_PRBS_PCFS := verilog/sport_tx_prbs_hx8k.pcf

verilog/sport_tx_prbs_%.pcf: src/sport_tx_prbs.nw | verilog
	cd verilog && tangle sport_tx_prbs_$*.pcf < ../$<

build/sport_tx_prbs/sport_tx_prbs.json: $(SPORT_TX_PRBS_VS) | build/sport_tx_prbs
	cd build/sport_tx_prbs && yosys -q -p "read_verilog ../../verilog/sport_tx_prbs.v; synth_ice40 -top sport_tx_prbs -json sport_tx_prbs.json"
@
